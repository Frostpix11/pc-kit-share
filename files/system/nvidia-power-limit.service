[Unit]
Description=NVIDIA RTX 3060: power limit 120 W + memory clock lock 5001-7501 MHz
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-smi -pl 120
ExecStart=/usr/bin/nvidia-smi -lmc 5001,7501
ExecStop=/usr/bin/nvidia-smi -rmc
ExecStop=/usr/bin/nvidia-smi -pl 170

[Install]
WantedBy=multi-user.target

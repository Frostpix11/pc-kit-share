#!/usr/bin/env python3
"""Claude Code Stop hook: read the end of Celestia's own answer and give her face its mood and a
short line. Fail-open: whatever goes wrong, the hook says nothing and exits 0.

Only her last answer is read, nothing is stored. Runs after each turn, costs no model call.
"""
import json
import re
import subprocess
import sys
import time

RULES = [  # (pattern, mood): first match wins
    (r"ах+а|ха+ха|\blol\b|смешн", "laugh"),
    (r"прости|извини|моя ошибк|виновата|зря |промах|погорячил", "shy"),
    (r"не сработал|упал[оа]?\b|сломал|завис|нашла .*баг|ошибк", "concerned"),
    (r"готово|получилось|сработал|починил|заработал|отличн|красот|вау", "proud"),
    (r"хорошо|ладно|понял[аи]?|давай", "happy"),
]


def quote(text):
    """The opening of her answer, short enough for the face: the first sentence, cut at a comma or
    a colon if it runs long, at a word as a last resort."""
    plain = re.sub(r"[*`#|]", "", text).strip()
    first = re.split(r"(?<=[.!?…])\s|\n", plain, maxsplit=1)[0].strip()
    if len(first) <= 80:
        return first if len(first) >= 3 else ""
    head = first[:80]
    cut = max(head.rfind(", "), head.rfind(": "), head.rfind(" — "))
    if cut >= 20:
        return head[:cut].rstrip(" ,:—")
    return head[:head.rfind(" ")].rstrip(" ,:—") + "…"


def last_text(path):
    """(uuid, text) of her last words in the transcript, if they are there yet."""
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 200000))
        lines = f.read().decode("utf-8", "ignore").splitlines()
    for line in reversed(lines):
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        msg = ev.get("message") or {}
        if ev.get("type") == "user" and isinstance(msg.get("content"), str):
            return None, ""          # the owner spoke last: this turn's words are not written yet
        if ev.get("type") == "assistant" and isinstance(msg.get("content"), list):
            parts = [c.get("text", "") for c in msg["content"] if c.get("type") == "text"]
            if parts:
                return ev.get("uuid"), "\n".join(parts).strip()
    return None, ""


def main():
    data = json.load(sys.stdin)
    # Claude Code hands the answer over itself; the transcript lags behind the hook, and reading
    # it at once gave the answer before this one
    text = (data.get("last_assistant_message") or "").strip()
    path = data.get("transcript_path")
    if not text and path:
        for _ in range(12):
            _, text = last_text(path)
            if text:
                break
            time.sleep(0.2)
    if not text:
        return
    # the tone is in how the answer opens, its first sentence: a report further down always names some error or hang,
    # and "Всё чисто… ошибки ядра 0" made her worry
    line = quote(text)
    low = line.lower()
    mood = next((m for pat, m in RULES if re.search(pat, low)), "happy")
    subprocess.run(["qs", "-c", "angelos", "ipc", "call", "celestia", "mood", mood, "0.9", line, "20"],
                   timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


try:
    main()
except Exception:
    pass
sys.exit(0)

diff --git a/.config/quickshell/angelos/shaders/genie.vert b/.config/quickshell/angelos/shaders/genie.vert
index 0f63b83..c6d97d8 100644
--- a/.config/quickshell/angelos/shaders/genie.vert
+++ b/.config/quickshell/angelos/shaders/genie.vert
@@ -47,8 +47,9 @@ void main() {
     if (flip > 0.5)
         y = screenH - y;
     if (snap > 0.0) {
-        x = floor(x / snap + 0.5) * snap;
-        y = floor(y / snap + 0.5) * snap;
+        // Keep division finite even when snapping is disabled (Golden Gate: snap = 0).
+        x = floor(x / max(snap, 1.0) + 0.5) * snap;
+        y = floor(y / max(snap, 1.0) + 0.5) * snap;
     }
     qt_TexCoord0 = qt_MultiTexCoord0;
     gl_Position = qt_Matrix * vec4(x, y, 0.0, 1.0);

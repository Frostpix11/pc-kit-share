+#[cfg(test)]
+mod hold_tests {
+    use super::*;
+
+    fn win(w: u16, h: u16) -> WindowData {
+        WindowData::new(false, WindowDims { x: 0, y: 0, width: w, height: h }, None)
+    }
+
+    #[test]
+    fn a_held_window_scales_the_pointer_only_while_held() {
+        let mut d = win(1920, 1080);
+        d.wl_size = Some((1920, 1080));
+        assert_eq!(d.hold_factor(), None, "no hold");
+        d.hold = Some((1280, 960));
+        assert_eq!(d.emulated_size(), Some((1280, 960)));
+        assert_eq!(d.hold_factor(), None, "the window is not at the held size yet");
+        d.attrs.dims.width = 1280;
+        d.attrs.dims.height = 960;
+        let (fx, fy) = d.hold_factor().unwrap();
+        assert!((fx - 1280. / 1920.).abs() < 1e-9 && (fy - 960. / 1080.).abs() < 1e-9);
+        // Xwayland's own emulation wins: it scales the pointer itself
+        d.emu_rects = vec![[0, 0, 800, 600]];
+        assert_eq!(d.emulated_size(), Some((800, 600)));
+        assert_eq!(d.hold_factor(), None);
+    }
+}

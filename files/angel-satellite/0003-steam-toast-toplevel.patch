+// angel: a Steam toast is a toplevel with the keyboard off X11, a popup with it on X11
+fn steam_toast_is_toplevel(keyboard_on_x: bool) -> bool {
+    let (mut f, comp) = TestFixture::new_with_compositor();
+    let win1 = Window::new(1);
+    let (_, id1) = f.create_toplevel(&comp, win1);
+    f.testwl.configure_toplevel(id1, 100, 100, vec![]);
+    f.run();
+    f.satellite.keyboard_on_x = keyboard_on_x;
+
+    let toast = Window::new(2);
+    let (buffer, surface) = comp.create_surface();
+    f.new_window(
+        toast,
+        true,
+        WindowData {
+            dims: WindowDims {
+                width: 300,
+                height: 100,
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+    );
+    f.satellite.set_win_title(
+        toast,
+        crate::xstate::WmName::WmName("notificationtoasts_7_desktop".into()),
+    );
+    f.map_window(&comp, toast, &surface.obj, &buffer);
+    f.run();
+    let id = f.check_new_surface();
+    matches!(
+        f.testwl.get_surface_data(id).unwrap().role,
+        Some(testwl::SurfaceRole::Toplevel(_))
+    )
+}
+
+#[test]
+fn steam_toast_is_toplevel_without_x11_focus() {
+    assert!(steam_toast_is_toplevel(false));
+}
+
+#[test]
+fn steam_toast_is_popup_with_x11_focus() {
+    assert!(!steam_toast_is_toplevel(true));
+}

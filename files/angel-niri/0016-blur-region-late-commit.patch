+/// Re-reads the current blur region; true when it differs from the cached one.
+fn refresh_blur_region(states: &SurfaceData, inner: &mut CachedBlurRegionInner) -> bool {
+    let cached = &states.cached_state;
+    let mut fresh: Option<Vec<Rectangle<i32, Logical>>> = None;
+    if cached.has::<BackgroundEffectSurfaceCachedState>() {
+        let mut guard = cached.get::<BackgroundEffectSurfaceCachedState>();
+        if let Some(region) = &guard.current().blur_region {
+            let mut rects = Vec::new();
+            region_to_non_overlapping_rects(region, &mut rects);
+            fresh = Some(rects);
+        }
+    }
+    let same = match (&inner.rects, &fresh) {
+        (None, None) => true,
+        (Some(old), Some(new)) => **old == *new,
+        _ => false,
+    };
+    if !same {
+        inner.rects = fresh.map(Arc::new);
+    }
+    !same
+}

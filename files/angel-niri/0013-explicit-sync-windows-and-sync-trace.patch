diff --git a/src/sync_trace.rs b/src/sync_trace.rs
new file mode 100644
index 00000000..60081b03
--- /dev/null
+++ b/src/sync_trace.rs
@@ -0,0 +1,113 @@
+//! angel-niri: ANGEL_NIRI_SYNC_TRACE=1 — a look at how a busy surface's frames come in, every 2 s
+//! in the log: commits a second, the gaps between them (a client short of buffers shows long
+//! ones) and how long each waited for its explicit-sync acquire point. Off: nothing is done.
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::time::{Duration, Instant};
+
+use smithay::reexports::wayland_server::backend::ObjectId;
+
+#[derive(Default)]
+struct Stat {
+    label: String,
+    frames: u32,
+    last: Option<Instant>,
+    gaps: Vec<f32>,
+    waits: Vec<f32>,
+    synced: u32,
+}
+
+thread_local! {
+    static ON: bool = std::env::var_os("ANGEL_NIRI_SYNC_TRACE").is_some_and(|v| v == "1");
+    static STATS: RefCell<(Option<Instant>, HashMap<ObjectId, Stat>)> = RefCell::new((None, HashMap::new()));
+}
+
+pub fn enabled() -> bool {
+    ON.with(|on| *on)
+}
+
+/// A dmabuf commit of `id` came in now.
+pub fn commit(id: &ObjectId, synced: bool, label: impl FnOnce() -> String) -> Instant {
+    let now = Instant::now();
+    STATS.with(|s| {
+        let mut s = s.borrow_mut();
+        let st = s.1.entry(id.clone()).or_default();
+        if st.label.is_empty() {
+            st.label = label();
+        }
+        if let Some(last) = st.last {
+            st.gaps.push((now - last).as_secs_f32() * 1000.);
+        }
+        st.last = Some(now);
+        if synced {
+            st.synced += 1;
+        }
+    });
+    report(now);
+    now
+}
+
+/// niri sent `id` a frame callback (its turn to draw).
+pub fn frame(id: &ObjectId) {
+    STATS.with(|s| {
+        if let Some(st) = s.borrow_mut().1.get_mut(id) {
+            st.frames += 1;
+        }
+    });
+}
+
+/// Its acquire point was signalled (the commit `since` may go on).
+pub fn cleared(id: &ObjectId, since: Instant) {
+    let ms = since.elapsed().as_secs_f32() * 1000.;
+    STATS.with(|s| {
+        if let Some(st) = s.borrow_mut().1.get_mut(id) {
+            st.waits.push(ms);
+        }
+    });
+}
+
+fn pct(v: &mut [f32], p: f32) -> f32 {
+    if v.is_empty() {
+        return 0.;
+    }
+    v.sort_by(|a, b| a.total_cmp(b));
+    v[((v.len() - 1) as f32 * p) as usize]
+}
+
+fn report(now: Instant) {
+    STATS.with(|s| {
+        let mut s = s.borrow_mut();
+        let start = *s.0.get_or_insert(now);
+        if now - start < Duration::from_secs(2) {
+            return;
+        }
+        let secs = (now - start).as_secs_f32();
+        s.0 = Some(now);
+        for (id, st) in s.1.iter_mut() {
+            let n = st.gaps.len();
+            if n >= 200 {
+                let med = pct(&mut st.gaps, 0.5);
+                let long = st.gaps.iter().filter(|g| **g > 1.8 * med).count();
+                let p99 = pct(&mut st.gaps, 0.99);
+                let max = pct(&mut st.gaps, 1.0);
+                let wn = st.waits.len();
+                let wmean = if wn > 0 { st.waits.iter().sum::<f32>() / wn as f32 } else { 0. };
+                let wp99 = pct(&mut st.waits, 0.99);
+                let wmax = pct(&mut st.waits, 1.0);
+                info!(
+                    "sync-trace {id} {}: {:.0} commits/s, {:.0} frame callbacks/s ({} synced), gap median {med:.2} p99 {p99:.2} max {max:.1} ms, >1.8x median {long} ({:.1}%), acquire wait mean {wmean:.2} p99 {wp99:.2} max {wmax:.1} ms ({wn})",
+                    st.label,
+                    n as f32 / secs,
+                    st.frames as f32 / secs,
+                    st.synced,
+                    long as f32 * 100. / n as f32
+                );
+            }
+            st.gaps.clear();
+            st.waits.clear();
+            st.synced = 0;
+            st.frames = 0;
+        }
+        s.1.retain(|_, st| st.last.is_some_and(|l| now - l < Duration::from_secs(5)));
+    });
+}

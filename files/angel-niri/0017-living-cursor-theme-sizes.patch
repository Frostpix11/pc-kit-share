+    /// angel-niri (pc-kit 0017): the named cursor's picture closest to `px` pixels. The living
+    /// pointer (cursor_fx) draws the arrow bigger than the theme size; it takes the theme's bigger
+    /// picture and magnifies only what is left, instead of magnifying the small one (a smooth
+    /// cursor went jagged at ×1.5; pixel themes with one size stay as they were).
+    pub fn get_cursor_near(&self, icon: CursorIcon, px: i32) -> Option<Rc<XCursor>> {
+        self.sized_cursor_cache
+            .borrow_mut()
+            .entry((icon, px))
+            .or_insert_with_key(|(icon, px)| {
+                let mut cursor = Self::load_xcursor(&self.theme, icon.name(), *px);
+                if cursor.is_err() {
+                    for name in icon.alt_names() {
+                        cursor = Self::load_xcursor(&self.theme, name, *px);
+                        if cursor.is_ok() {
+                            break;
+                        }
+                    }
+                }
+                cursor.ok().map(Rc::new)
+            })
+            .clone()
+    }
+
+    /// The theme size, logical px.
+    pub fn size(&self) -> u8 {

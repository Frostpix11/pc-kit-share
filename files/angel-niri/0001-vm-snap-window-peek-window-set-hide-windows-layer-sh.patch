diff --git a/src/peek.rs b/src/peek.rs
new file mode 100644
index 00000000..3a9c3411
--- /dev/null
+++ b/src/peek.rs
@@ -0,0 +1,27 @@
+//! angel-niri (for angelOS's Aero Peek, the shell's modules/bar/parts/Tasks): `peek-window --id N`
+//! — the other windows of N's output fade away (their tiles' alpha down to nothing, held), only N
+//! stays; `peek-window` without an id brings them back. Nothing else changes: focus, order and
+//! places stay as they were.
+
+use std::cell::Cell;
+
+use crate::niri::State;
+
+thread_local! {
+    static PEEKED: Cell<Option<u64>> = const { Cell::new(None) };
+}
+
+impl State {
+    pub fn peek_window(&mut self, id: Option<u64>) {
+        if PEEKED.replace(id) == id {
+            return;
+        }
+        let keep = id.and_then(|id| {
+            (self.niri.layout.windows())
+                .find(|(_, m)| m.id().get() == id)
+                .and_then(|(mon, m)| Some((m.window.clone(), mon?.output().clone())))
+        });
+        self.niri.layout.peek(keep.as_ref().map(|(window, output)| (window, output)));
+        self.niri.queue_redraw_all();
+    }
+}

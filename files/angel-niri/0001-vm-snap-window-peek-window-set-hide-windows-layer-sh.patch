new file mode 100644
index 00000000..872899ea
--- /dev/null
+++ b/src/snap_assist.rs
@@ -0,0 +1,166 @@
+//! angel-niri (for angelOS's Snap Layouts, the shell's services/SnapAssist): `snap-window --zone Z
+//! [--id N]` snaps a floating window to a part of its working area while stacking — the halves,
+//! the quarters, the thirds (stacking.rs `Snap`); and the shell hears where windows sit snapped
+//! and where a dragged one is:
+//!
+//!   `Event::WindowSnapped`         every change — dragged to an edge, Mod+arrows, a zone asked
+//!                                  for, left — with the room the parts divide (zone "" when it
+//!                                  no longer sits snapped)
+//!   `Event::WindowDraggedNearTop`  while a window is dragged near the top of an output, where the
+//!                                  pointer is on it (the shell's snap bar comes down there); no
+//!                                  pos once it leaves, `dropped` when let go there
+//!
+//! Both are read off the layout once a refresh, not sent from each place that snaps; a snap asked
+//! for again (a zone, Mod+arrow, a window let go) goes out even when it is where it was, so the
+//! shell offers the rest of its layout every time.
+
+use std::cell::RefCell;
+use std::collections::{HashMap, HashSet};
+
+use niri_ipc::Event;
+
+use crate::niri::State;
+use crate::stacking::Snap;
+
+/// How near the top of its output the pointer brings the snap bar down, in logical pixels.
+const NEAR_TOP: f64 = 120.;
+
+/// A window dragged: its id, its output and where the pointer is near the top (if it is).
+type Drag = (u64, String, Option<[f64; 2]>);
+
+thread_local! {
+    static SNAPS: RefCell<HashMap<u64, (String, Snap)>> = RefCell::new(HashMap::new());
+    static DRAG: RefCell<Option<Drag>> = const { RefCell::new(None) };
+    static ASKED: RefCell<HashSet<u64>> = RefCell::new(HashSet::new());
+}
+
+/// The window's snap was asked for: the shell hears it at the next refresh, changed or not.
+pub fn asked(id: u64) {
+    ASKED.with_borrow_mut(|asked| asked.insert(id));
+}
+
+impl State {
+    /// Snaps a floating window (the focused one without an id) to `zone`; an unknown zone gives
+    /// it back its own place and size.
+    pub fn snap_window(&mut self, id: Option<u64>, zone: &str) {
+        if !crate::stacking::on() {
+            return;
+        }
+        let focused = self.niri.layout.focus().map(|m| m.id().get());
+        let Some(id) = id.or(focused) else {
+            return;
+        };
+        let Some(window) = (self.niri.layout.windows())
+            .find(|(_, m)| m.id().get() == id)
+            .map(|(_, m)| m.window.clone())
+        else {
+            return;
+        };
+        // a tiled window has no part of the screen to fill
+        if self.niri.layout.floating_snap(&window).is_none() {
+            return;
+        }
+        asked(id);
+        self.niri.layout.set_floating_snap(&window, Snap::from_name(zone));
+        self.niri.queue_redraw_all();
+    }
+
+    /// Once a refresh: the snaps and the drag near the top that changed go to the shell.
+    pub fn refresh_snap_assist(&mut self) {
+        let mut events = Vec::new();
+
+        let drag = (self.niri.layout.stacking_drag())
+            .map(|(mapped, output, pos)| (mapped.id().get(), output.name(), pos));
+        let dragged = drag.as_ref().map(|(id, _, _)| *id);
+        DRAG.with_borrow_mut(|last| match drag {
+            Some((id, output, pos)) => {
+                let near = (pos.y < NEAR_TOP).then(|| [pos.x.round(), pos.y.round()]);
+                let was_near = last.as_ref().is_some_and(|(_, _, pos)| pos.is_some());
+                let now = (id, output, near);
+                if (near.is_some() || was_near) && last.as_ref() != Some(&now) {
+                    events.push(Event::WindowDraggedNearTop {
+                        id,
+                        output: now.1.clone(),
+                        pos: near,
+                        dropped: false,
+                    });
+                }
+                *last = Some(now);
+            }
+            None => {
+                // let go: where it lands (an edge, or not) counts as asked
+                if let Some((id, _, _)) = last.as_ref() {
+                    asked(*id);
+                }
+                if let Some((id, output, Some(pos))) = last.take() {
+                    events.push(Event::WindowDraggedNearTop {
+                        id,
+                        output,
+                        pos: Some(pos),
+                        dropped: true,
+                    });
+                }
+            }
+        });
+
+        let mut snapped = HashMap::new();
+        let mut free = Vec::new();
+        for (mon, _, ws) in self.niri.layout.workspaces() {
+            let Some(mon) = mon else {
+                continue;
+            };
+            let floating = ws.floating();
+            for tile in floating.tiles() {
+                let mapped = tile.window();
+                let id = mapped.id().get();
+                match floating.snap(&mapped.window) {
+                    Some(snap) => {
+                        let room = floating.snap_room(&mapped.window).unwrap_or_default();
+                        let area = [room.loc.x, room.loc.y, room.size.w, room.size.h];
+                        snapped.insert(id, (mon.output_name().clone(), snap, area));
+                    }
+                    None => free.push(id),
+                }
+            }
+        }
+        let asked = ASKED.take();
+        SNAPS.with_borrow_mut(|snaps| {
+            for (&id, (output, snap, area)) in &snapped {
+                if asked.contains(&id) || snaps.get(&id) != Some(&(output.clone(), *snap)) {
+                    events.push(Event::WindowSnapped {
+                        id,
+                        output: output.clone(),
+                        zone: snap.name().to_owned(),
+                        area: *area,
+                    });
+                }
+            }
+            for id in free {
+                if let Some((output, _)) = snaps.get(&id) {
+                    events.push(Event::WindowSnapped {
+                        id,
+                        output: output.clone(),
+                        zone: String::new(),
+                        area: [0.; 4],
+                    });
+                }
+            }
+            // a window dragged is out of its workspace meanwhile: it keeps its part till it lands
+            let held = dragged.and_then(|id| snaps.get(&id).cloned().map(|was| (id, was)));
+            *snaps = (snapped.into_iter())
+                .map(|(id, (output, snap, _))| (id, (output, snap)))
+                .collect();
+            if let Some((id, was)) = held {
+                snaps.entry(id).or_insert(was);
+            }
+        });
+
+        if let Some(server) = &self.niri.ipc_server {
+            for event in events {
+                server.send_transient_event(event);
+            }
+        }
+
+        self.refresh_show_desktop();
+    }
+}

new file mode 100644
index 00000000..2b1b388f
--- /dev/null
+++ b/src/show_desktop.rs
@@ -0,0 +1,123 @@
+//! angel-niri (for angelOS's «Показать стол», the shell's services/DeskMenu): `show-desktop
+//! [--output NAME]` parts the floating windows of the output's active workspace to the side edges
+//! in one motion, as on a Mac — each to the nearer one, a sliver of it left on screen — and they
+//! come back to their places (snapped ones to their parts: moving keeps the snap) with the same
+//! call again, a window focused (a click on a sliver, the taskbar) or a new one opened.
+//!
+//! shortcut: tiled windows (not stacking) stay where they are.
+
+use std::cell::RefCell;
+
+use niri_ipc::PositionChange;
+use smithay::utils::{Logical, Point};
+
+use crate::niri::State;
+
+/// How much of a parted window stays on screen.
+const SLIVER: f64 = 24.;
+
+struct Parted {
+    /// The windows and where they were, relative to the working area.
+    windows: Vec<(u64, Point<f64, Logical>)>,
+    focus: Option<u64>,
+    count: usize,
+    workspace: u64,
+}
+
+thread_local! {
+    static PARTED: RefCell<Option<Parted>> = const { RefCell::new(None) };
+}
+
+impl State {
+    pub fn show_desktop(&mut self, output: Option<String>) {
+        if PARTED.with_borrow(|p| p.is_some()) {
+            self.show_desktop_back();
+            return;
+        }
+        let active = self.niri.layout.active_output().cloned();
+        let Some(mon) = self.niri.layout.monitors().find(|mon| match &output {
+            Some(name) => mon.output_name() == name,
+            None => Some(mon.output()) == active.as_ref(),
+        }) else {
+            return;
+        };
+        let ws = mon.active_workspace_ref();
+        let area = ws.working_area();
+        let floating = ws.floating();
+        let mut windows = Vec::new();
+        let mut moves = Vec::new();
+        for tile in floating.tiles() {
+            let mapped = tile.window();
+            let Some(rect) = floating.window_rect(&mapped.window) else {
+                continue;
+            };
+            let left = rect.loc.x + rect.size.w / 2. < area.loc.x + area.size.w / 2.;
+            let x = if left {
+                SLIVER - rect.size.w
+            } else {
+                area.size.w - SLIVER
+            };
+            windows.push((mapped.id().get(), rect.loc - area.loc));
+            moves.push((mapped.window.clone(), x, rect.loc.y - area.loc.y));
+        }
+        if moves.is_empty() {
+            return;
+        }
+        let parted = Parted {
+            windows,
+            focus: self.niri.layout.focus().map(|m| m.id().get()),
+            count: ws.windows().count(),
+            workspace: ws.id().get(),
+        };
+        for (window, x, y) in moves {
+            self.niri.layout.move_floating_window(
+                Some(&window),
+                PositionChange::SetFixed(x),
+                PositionChange::SetFixed(y),
+                true,
+            );
+        }
+        PARTED.set(Some(parted));
+        self.niri.queue_redraw_all();
+    }
+
+    fn show_desktop_back(&mut self) {
+        let Some(parted) = PARTED.take() else {
+            return;
+        };
+        for (id, pos) in parted.windows {
+            let Some(window) = (self.niri.layout.windows())
+                .find(|(_, m)| m.id().get() == id)
+                .map(|(_, m)| m.window.clone())
+            else {
+                continue;
+            };
+            if self.niri.layout.floating_snap(&window).is_none() {
+                continue;
+            }
+            self.niri.layout.move_floating_window(
+                Some(&window),
+                PositionChange::SetFixed(pos.x),
+                PositionChange::SetFixed(pos.y),
+                true,
+            );
+        }
+        self.niri.queue_redraw_all();
+    }
+
+    /// Once a refresh: a window focused or opened on the parted workspace brings them back.
+    pub fn refresh_show_desktop(&mut self) {
+        let Some((focus, count, workspace)) =
+            PARTED.with_borrow(|p| p.as_ref().map(|p| (p.focus, p.count, p.workspace)))
+        else {
+            return;
+        };
+        let now = self.niri.layout.focus().map(|m| m.id().get());
+        let here = (self.niri.layout.workspaces())
+            .find(|(_, _, ws)| ws.id().get() == workspace)
+            .map(|(_, _, ws)| ws.windows().count());
+        if now != focus || here.is_none_or(|n| n > count) {
+            self.show_desktop_back();
+        }
+    }
+}

diff --git a/src/hide_windows.rs b/src/hide_windows.rs
new file mode 100644
index 00000000..20ca4616
--- /dev/null
+++ b/src/hide_windows.rs
@@ -0,0 +1,23 @@
+//! angel-niri (for angelOS's Mission Control, the shell's services/Mission): `niri msg action
+//! set-hide-windows-layer --namespace NS [--on false]`: while a layer-shell surface of that
+//! namespace is on an output, the output's windows are not drawn there — the desktop (the
+//! background and bottom layers) shows under it, as under a Mac's Mission Control, whose cards
+//! show the windows instead. Screencasts and screenshots see the same. Nothing goes to niri's
+//! config.
+
+use std::sync::Mutex;
+
+static NAMESPACES: Mutex<Vec<String>> = Mutex::new(Vec::new());
+
+pub fn set(namespace: String, on: bool) {
+    let mut namespaces = NAMESPACES.lock().unwrap();
+    namespaces.retain(|ns| *ns != namespace);
+    if on {
+        namespaces.push(namespace);
+    }
+}
+
+/// Whether a layer surface of this namespace hides the windows of its output.
+pub fn hides(namespace: &str) -> bool {
+    NAMESPACES.lock().unwrap().iter().any(|ns| ns == namespace)
+}

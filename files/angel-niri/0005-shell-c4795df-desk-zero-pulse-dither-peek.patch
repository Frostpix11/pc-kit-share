diff --git a/src/window_dither.rs b/src/window_dither.rs
new file mode 100644
index 00000000..71f94446
--- /dev/null
+++ b/src/window_dither.rs
@@ -0,0 +1,95 @@
+//! angel-niri: Alt+wheel over a window makes it see-through in dots (`niri msg action
+//! set-dither-wheel --on true`), what angelOS's shell turns on from Settings → Windows →
+//! «Прозрачность окна колесом» (services/WindowDither.qml). A Bayer screen door with no blending:
+//! wheel down, more of the window's dots go and what is behind shows through them; wheel up, they
+//! come back. Fullscreen windows stay whole (and keep their Alt+wheel); while it is on the other
+//! apps don't get Alt+wheel. Nothing is remembered: off, or a new login, and every window is whole.
+//! Drawn by Tile::render through an offscreen copy and dither.frag.
+//! Written to the shell's contract (angelOS c4795df), before the author published his own build.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use smithay::backend::renderer::element::Id;
+
+/// Steps of the wheel from whole to the most see-through (a 4×4 Bayer matrix has 16 levels; the
+/// last few would leave next to nothing to grab).
+pub const STEPS: u8 = 12;
+
+static ON: AtomicBool = AtomicBool::new(false);
+
+thread_local! {
+    static LEVELS: RefCell<HashMap<u64, u8>> = RefCell::new(HashMap::new());
+    /// a render element id per (window, level): a new level damages the whole window
+    static IDS: RefCell<HashMap<(u64, u8), Id>> = RefCell::new(HashMap::new());
+}
+
+/// The element id for window `id` at its current level; none while it is whole.
+pub fn element_id(id: u64) -> Option<Id> {
+    let lvl = LEVELS.with_borrow(|l| l.get(&id).copied())?;
+    if !is_on() {
+        return None;
+    }
+    Some(IDS.with_borrow_mut(|ids| ids.entry((id, lvl)).or_insert_with(Id::new).clone()))
+}
+
+pub fn set_on(on: bool) {
+    ON.store(on, Ordering::Relaxed);
+    if !on {
+        LEVELS.with_borrow_mut(|l| l.clear());
+        IDS.with_borrow_mut(|ids| ids.clear());
+    }
+}
+
+pub fn is_on() -> bool {
+    ON.load(Ordering::Relaxed)
+}
+
+/// One notch of the wheel over window `id`: down (`steps` > 0) more see-through, up less.
+pub fn wheel(id: u64, steps: i32) {
+    LEVELS.with_borrow_mut(|l| {
+        let cur = i32::from(*l.get(&id).unwrap_or(&0));
+        let new = (cur + steps).clamp(0, i32::from(STEPS));
+        if new == 0 {
+            l.remove(&id);
+        } else {
+            l.insert(id, new as u8);
+        }
+    });
+}
+
+/// How much of window `id` is gone, 0 (whole) .. under 1.
+pub fn level(id: u64) -> f32 {
+    if !is_on() {
+        return 0.;
+    }
+    LEVELS.with_borrow(|l| l.get(&id).map_or(0., |&v| f32::from(v) / 16.))
+}
+
+pub fn forget(id: u64) {
+    LEVELS.with_borrow_mut(|l| l.remove(&id));
+    IDS.with_borrow_mut(|ids| ids.retain(|(w, _), _| *w != id));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_wheel_goes_and_comes_back() {
+        set_on(true);
+        wheel(7, 3);
+        assert_eq!(level(7), 3. / 16.);
+        wheel(7, 100);
+        assert_eq!(level(7), f32::from(STEPS) / 16.);
+        wheel(7, -100);
+        assert_eq!(level(7), 0.);
+        wheel(7, 2);
+        set_on(false);
+        assert_eq!(level(7), 0.);
+        set_on(true);
+        assert_eq!(level(7), 0., "off forgets");
+        set_on(false);
+    }
+}
diff --git a/src/window_pulse.rs b/src/window_pulse.rs
new file mode 100644
index 00000000..a02b774a
--- /dev/null
+++ b/src/window_pulse.rs
@@ -0,0 +1,85 @@
+//! angel-niri: the windows spring a pixel or two on each kick of the music (`niri msg action
+//! window-pulse --px 2 --ms 180`), what angelOS's shell sends from its drum hearing
+//! (services/WindowPulse.qml, Settings → Windows → «Окна вздрагивают под бочку»). The tiles are
+//! rescaled about their centres as they are drawn (Tile::deform, the throw's squash path), so
+//! nothing is drawn twice; fullscreen windows (games, videos) stay put. A pulse rises fast and
+//! eases back over `ms`; a new kick starts over from where the last one is. px 0 / ms 0 is the
+//! shell's probe: accepted, nothing moves.
+//! Written to the shell's contract (angelOS c4795df), before the author published his own build.
+
+use std::cell::Cell;
+use std::time::{Duration, Instant};
+
+/// Up to this many px on each side, whatever is asked.
+const MAX_PX: f64 = 6.;
+/// The share of the pulse spent growing; the rest eases back.
+const RISE: f64 = 0.22;
+
+thread_local! {
+    static PULSE: Cell<Option<(Instant, f64, Duration)>> = const { Cell::new(None) };
+}
+
+pub fn pulse(px: f64, ms: u32) {
+    let px = if px.is_finite() { px.clamp(0., MAX_PX) } else { 0. };
+    if px <= 0. || ms == 0 {
+        return;
+    }
+    // a kick over a pulse still going: from its current height, never smaller
+    let now = Instant::now();
+    let px = px.max(amount_at(now));
+    PULSE.set(Some((now, px, Duration::from_millis(u64::from(ms.min(2000))))));
+}
+
+fn amount_at(now: Instant) -> f64 {
+    let Some((at, px, dur)) = PULSE.get() else {
+        return 0.;
+    };
+    let t = now.saturating_duration_since(at).as_secs_f64() / dur.as_secs_f64().max(1e-3);
+    if t >= 1. {
+        return 0.;
+    }
+    let k = if t < RISE {
+        // ease out to the top
+        let x = t / RISE;
+        1. - (1. - x) * (1. - x)
+    } else {
+        // ease back down
+        let x = (t - RISE) / (1. - RISE);
+        (1. - x) * (1. - x)
+    };
+    px * k
+}
+
+/// Pixels each side of a window grows by just now.
+pub fn amount() -> f64 {
+    amount_at(Instant::now())
+}
+
+/// Whether the next frames still move.
+pub fn animating() -> bool {
+    PULSE.get().is_some_and(|(at, _, dur)| at.elapsed() < dur + Duration::from_millis(20))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rises_and_settles() {
+        let t0 = Instant::now();
+        PULSE.set(Some((t0, 2., Duration::from_millis(200))));
+        assert_eq!(amount_at(t0), 0.);
+        let top = amount_at(t0 + Duration::from_millis(44));
+        assert!((top - 2.).abs() < 0.01, "{top}");
+        assert!(amount_at(t0 + Duration::from_millis(120)) < top);
+        assert_eq!(amount_at(t0 + Duration::from_millis(200)), 0.);
+        PULSE.set(None);
+    }
+
+    #[test]
+    fn the_probe_moves_nothing() {
+        PULSE.set(None);
+        pulse(0., 0);
+        assert!(!animating());
+    }
+}

diff --git a/src/desk_zero.rs b/src/desk_zero.rs
new file mode 100644
index 00000000..697a6725
--- /dev/null
+++ b/src/desk_zero.rs
@@ -0,0 +1,58 @@
+//! angel-niri: the clean desk above desk 1 (`niri msg action set-desk-zero`), what angelOS's
+//! shell asks for at start (services/Niri.qml: SetDeskZero). niri's own
+//! `empty-workspace-above-first` keeps the empty workspace on top; on top of that this numbers the
+//! workspaces from 0 instead of 1 while it is on, so that one is desk 0 and the desks with windows
+//! stay 1…N — in the IPC (`idx`), in index references (`focus-workspace 3`,
+//! `move-column-to-workspace 0`) and in the labels. A window put on desk 0 makes it desk 1 (same
+//! id, idx 1) and a new empty desk 0 comes on top: the shell sees that as deskZeroTaken.
+//! Written to the shell's contract (angelOS c4795df), before the author published his own build.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static ON: AtomicBool = AtomicBool::new(false);
+
+pub fn set(on: bool) {
+    ON.store(on, Ordering::Relaxed);
+}
+
+pub fn is_on() -> bool {
+    ON.load(Ordering::Relaxed)
+}
+
+/// A 1-based (desk 0 off) or 0-based (desk 0 on) index from a reference → the position in the
+/// output's workspace list.
+pub fn index_to_pos(index: u8) -> usize {
+    if is_on() {
+        usize::from(index)
+    } else {
+        usize::from(index.saturating_sub(1))
+    }
+}
+
+/// The position in the output's workspace list → the number shown and reported.
+pub fn pos_to_index(pos: usize) -> usize {
+    if is_on() {
+        pos
+    } else {
+        pos + 1
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn numbering_follows_the_switch() {
+        set(false);
+        assert_eq!(index_to_pos(1), 0);
+        assert_eq!(index_to_pos(0), 0);
+        assert_eq!(pos_to_index(0), 1);
+        set(true);
+        assert_eq!(index_to_pos(0), 0);
+        assert_eq!(index_to_pos(1), 1);
+        assert_eq!(pos_to_index(0), 0);
+        assert_eq!(pos_to_index(2), 2);
+        set(false);
+    }
+}

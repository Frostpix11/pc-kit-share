+#endif
+
+// angel-niri (window_dither.rs): a Bayer screen door, no blending. dither_level of the window's
+// dots are gone (0 whole .. 1 none), in cells of dither_cell physical pixels.
+uniform float dither_level;
+uniform float dither_cell;
+
+float bayer4(vec2 p) {
+    // 4x4 ordered-dither threshold in (0, 1)
+    float x = mod(p.x, 4.0);
+    float y = mod(p.y, 4.0);
+    float m;
+    if (y < 1.0) m = x < 1.0 ? 0.0 : x < 2.0 ? 8.0 : x < 3.0 ? 2.0 : 10.0;
+    else if (y < 2.0) m = x < 1.0 ? 12.0 : x < 2.0 ? 4.0 : x < 3.0 ? 14.0 : 6.0;
+    else if (y < 3.0) m = x < 1.0 ? 3.0 : x < 2.0 ? 11.0 : x < 3.0 ? 1.0 : 9.0;
+    else m = x < 1.0 ? 15.0 : x < 2.0 ? 7.0 : x < 3.0 ? 13.0 : 5.0;
+    return (m + 0.5) / 16.0;
+}
+
+void main() {
+    vec2 cell = floor(gl_FragCoord.xy / max(dither_cell, 1.0));
+    if (bayer4(cell) < dither_level) {
+        gl_FragColor = vec4(0.0);
+        return;
+    }
+    vec4 color = texture2D(tex, v_coords);
+#if defined(NO_ALPHA)
+    color = vec4(color.rgb, 1.0);
+#endif
+    color = color * alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}

+    /// angel-niri: the windows anyone can see on this workspace now (drawn and inside the view);
+    /// None while something moves (a scroll, an open/close, a resize): then every one counts.
+    pub fn seen_window_ids(&self) -> Option<Vec<W::Id>> {
+        if self.are_animations_ongoing() {
+            return None;
+        }
+        let view = Rectangle::from_size(self.view_size());
+        let mut seen = Vec::new();
+        for (tile, pos, visible) in self.tiles_with_render_positions() {
+            if visible && Rectangle::new(pos, tile.tile_size()).overlaps(view) {
+                seen.push(tile.window().id().clone());
+            }
+        }
+        Some(seen)
+    }
+
